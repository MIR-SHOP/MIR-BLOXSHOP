<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MIR BLOX SHOP</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#10101d;color:white;font-family:Arial,sans-serif}
header{text-align:center;padding:28px 12px;background:#21183b}
header h1{color:#b99aff;margin:0;font-size:30px}
header p{color:#ddd}
main{max-width:1000px;margin:auto;padding:16px}
h2{text-align:center;color:#d0baff}
#products{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:13px}
.card{background:#211f35;border:1px solid #494064;border-radius:14px;padding:14px;text-align:center}
.fruit{font-size:48px}
.card h3{margin:8px 0}
.price{color:#d4b7ff}
.qty{display:flex;justify-content:center;align-items:center;gap:15px;margin:12px}
button{border:0;border-radius:8px;padding:9px 13px;background:#8054d9;color:white;font-weight:bold}
button:active{opacity:.7}
.cart{background:#211f35;padding:18px;border-radius:14px;margin-top:22px}
input{width:100%;padding:12px;border-radius:8px;border:0;margin:7px 0 12px}
.total{font-size:20px;color:#d4b7ff;font-weight:bold}
</style>
</head>
<body>
<header>
<h1>MIR BLOX SHOP</h1>
<p>BLOX FRUITS STORE</p>
</header>
<main>
<h2>🍇 جميع الفواكه</h2>
<div id="products"></div>
<div class="cart">
<h2>🛒 سلة الطلبات</h2>
<div id="cart"></div>
<p class="total" id="total">المجموع: 0</p>
<label>اسمك في Roblox</label>
<input id="username" placeholder="اكتب اسمك في Roblox">
<button onclick="sendOrder()">تجهيز الطلب</button>
<p id="message"></p>
</div>
</main>
<script>
const fruits = [
["Rocket","🚀",0],["Spin","🌀",0],["Blade","⚔️",0],
["Spring","🌸",0],["Bomb","💣",0],["Smoke","💨",0],
["Spike","📌",0],["Flame","🔥",0],["Eagle","🦅",0],
["Ice","❄️",0],["Sand","🏜️",0],["Dark","🌑",0],
["Diamond","💎",0],["Light","✨",0],["Rubber","🟣",0],
["Ghost","👻",0],["Magma","🌋",0],["Quake","🌊",0],
["Buddha","🧘",0],["Love","❤️",0],["Creation","🎨",0],
["Spider","🕷️",0],["Sound","🎵",0],["Phoenix","🔥",0],
["Portal","🌀",0],["Lightning","⚡",0],["Pain","💥",0],
["Blizzard","🌨️",0],["Gravity","🌌",0],["Mammoth","🐘",0],
["T-Rex","🦖",0],["Dough","🍩",0],["Shadow","🌘",0],
["Venom","🐍",0],["Control","🎮",0],["Gas","☁️",0],
["Spirit","👻",0],["Leopard","🐆",0],["Yeti","❄️",0],
["Kitsune","🦊",0],["Dragon","🐉",0]
];
let quantities = fruits.map(()=>0);
const products=document.getElementById("products");
fruits.forEach((f,i)=>{
products.innerHTML+=`
<div class="card">
<div class="fruit">${f[1]}</div>
<h3>${f[0]}</h3>
<p class="price">السعر: <input type="number" min="0" value="${f[2]}" id="price${i}" onchange="updateCart()" style="width:75px"></p>
<div class="qty">
<button onclick="change(${i},-1)">−</button>
<b id="q${i}">0</b>
<button onclick="change(${i},1)">+</button>
</div>
</div>`;
});
function change(i,n){
quantities[i]=Math.max(0,quantities[i]+n);
document.getElementById("q"+i).textContent=quantities[i];
updateCart();
}
function updateCart(){
let html="",total=0;
fruits.forEach((f,i)=>{
if(quantities[i]>0){
let price=Number(document.getElementById("price"+i).value)||0;
let sum=price*quantities[i];total+=sum;
html+=`<p>${f[0]} × ${quantities[i]} = ${sum}</p>`;
}
});
document.getElementById("cart").innerHTML=html||"السلة فارغة";
document.getElementById("total").textContent="المجموع: "+total;
}
function sendOrder(){
let name=document.getElementById("username").value.trim();
if(!name){alert("اكتب اسم Roblox");return;}
let lines=fruits.map((f,i)=>quantities[i]>0?f[0]+" × "+quantities[i]:"").filter(Boolean);
if(!lines.length){alert("اختار فاكهة أولاً");return;}
document.getElementById("message").textContent=
"تم تجهيز الطلب محلياً، لكن لم يتم إرساله. اسم Roblox: "+name+" | "+lines.join("، ");
}
</script>
</body>
</html>
