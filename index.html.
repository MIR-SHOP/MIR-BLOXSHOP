
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MIR BLOX SHOP</title>
<style>
*{box-sizing:border-box}
body{
 margin:0;
 background:#090d18;
 color:white;
 font-family:Arial,sans-serif;
 text-align:center;
}
header{
 padding:35px 15px;
 background:linear-gradient(135deg,#171d35,#35215a);
 border-bottom:2px solid #a77cff;
}
h1{color:#c49aff;font-size:35px;margin:5px}
header p{color:#ddd}
h2{color:#c49aff;margin-top:30px}
.container{padding:15px;max-width:850px;margin:auto}
.products{
 display:grid;
 grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
 gap:15px;
}
.card{
 background:#171e31;
 border:1px solid #444d69;
 border-radius:15px;
 padding:20px 10px;
}
.fruit{font-size:38px}
.card h3{margin:10px 0;color:#fff}
.price{color:#c49aff;font-weight:bold}
button{
 background:#a77cff;color:#111;
 border:0;border-radius:10px;
 padding:12px 20px;font-weight:bold;
 cursor:pointer;margin-top:10px;
}
input{
 width:100%;padding:13px;margin:7px 0;
 border-radius:9px;border:1px solid #555;
 background:#11182a;color:white;
}
form{
 background:#171e31;padding:20px;
 border-radius:15px;margin:25px auto;
 max-width:450px;
}
footer{padding:25px;color:#888}
</style>
</head>
<body>

<header>
<h1>MIR BLOX SHOP</h1>
<p>Welcome To MIR Blox Fruits Shop</p>
</header>

<div class="container">
<h2>🍇 FRUITS SHOP</h2>

<div class="products">

<div class="card">
<div class="fruit">🔥</div>
<h3>Flame</h3>
<p class="price">Price: 50 Robux</p>
</div>

<div class="card">
<div class="fruit">🧊</div>
<h3>Ice</h3>
<p class="price">Price: 75 Robux</p>
</div>

<div class="card">
<div class="fruit">🌑</div>
<h3>Dark</h3>
<p class="price">Price: 100 Robux</p>
</div>

<div class="card">
<div class="fruit">🌋</div>
<h3>Magma</h3>
<p class="price">Price: 150 Robux</p>
</div>

<div class="card">
<div class="fruit">🐉</div>
<h3>Dragon</h3>
<p class="price">Price: 500 Robux</p>
</div>

<div class="card">
<div class="fruit">✨</div>
<h3>Light</h3>
<p class="price">Price: 125 Robux</p>
</div>

</div>

<h2>📩 REQUEST</h2>
<form onsubmit="event.preventDefault();alert('Your request has been prepared! Contact the shop owner through an official Roblox-approved method.');">
<input type="text" placeholder="Roblox Username" required>
<input type="text" placeholder="Fruit Name" required>
<button type="submit">SEND REQUEST</button>
</form>

</div>

<footer>
© 2026 MIR BLOX SHOP
</footer>

</body>
</html>
